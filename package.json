{
  "name": "wine-scanner",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "prepare": "husky",
    "ui:add": "pnpm --filter @repo/ui exec -- shadcn add",
    "compose:up": "docker compose --env-file .env -f infra/docker-compose.yml up -d",
    "compose:down": "docker compose --env-file .env -f infra/docker-compose.yml down",
    "compose:logs": "docker compose logs -f",
    "compose:restart": "docker compose restart"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "3.9.6",
    "turbo": "^2.10.12",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
